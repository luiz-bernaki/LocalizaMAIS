rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // Localiza+ LITE (projeto localizamais-d2dd1)
    // Versão resumida: visitantes visualizam,
    // logados comentam, apenas ADMIN gerencia anúncios.
    // ==========================================

    // ==========================================
    // Core Security & Auth Helper Functions
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function hasAdminClaim() {
      return isSignedIn() &&
             (request.auth.token.role == 'ADMIN' ||
              request.auth.token.admin == true);
    }

    function isRootAdmin() {
      return isSignedIn() &&
             request.auth.token.email != null &&
             (request.auth.token.email == '20251iva10030020@estudantes.ifpr.edu.br' ||
              request.auth.token.email.lower() == '20251iva10030020@estudantes.ifpr.edu.br');
    }

    function isDocAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvalStatus == 'APROVADO';
    }

    function isAdmin() {
      return hasAdminClaim() || isRootAdmin() || isDocAdmin();
    }

    function isDocServidor() {
      return isSignedIn() &&
             isEmailVerified() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SERVIDOR';
    }

    function isDocAluno() {
      return isSignedIn() &&
             isEmailVerified() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ALUNO';
    }

    function isDocIntruso() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'INTRUSO';
    }

    function isIntruso() {
      return isSignedIn() && (
        !isEmailVerified() ||
        request.auth.token.role == 'INTRUSO' ||
        isDocIntruso() ||
        (!isAdmin() && !isServidor() && !isDocAluno() && request.auth.token.email != null && (
          !request.auth.token.email.matches('.*@estudantes[.]ifpr[.]edu[.]br') &&
          !request.auth.token.email.matches('.*@estudante[.]ifpr[.]edu[.]br') &&
          !request.auth.token.email.matches('.*@aluno[.]ifpr[.]edu[.]br') &&
          !request.auth.token.email.matches('.*@ifpr[.]edu[.]br')
        ))
      );
    }

    function isAccountBlocked() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'banned' ||
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'suspended'
             );
    }

    function isAccountActive() {
      return !isAccountBlocked();
    }

    function isInstitutionalStudentEmail() {
      return isSignedIn() && isEmailVerified() && request.auth.token.email != null && (
        request.auth.token.email.matches('.*@estudantes[.]ifpr[.]edu[.]br') ||
        request.auth.token.email.matches('.*@estudante[.]ifpr[.]edu[.]br') ||
        request.auth.token.email.matches('.*@aluno[.]ifpr[.]edu[.]br')
      );
    }

    function isServidor() {
      return isSignedIn() &&
             (isAdmin() ||
              (isEmailVerified() && (
                (request.auth.token.role == 'SERVIDOR') ||
                isDocServidor() ||
                (!isDocAluno() && request.auth.token.email != null && (
                   request.auth.token.email.matches('.*@ifpr[.]edu[.]br') &&
                   !request.auth.token.email.matches('.*@aluno[.]ifpr[.]edu[.]br') &&
                   !request.auth.token.email.matches('.*@escola[.]ifpr[.]edu[.]br')
                ))
              )));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Defensive input limits matching ITEM_FIELD_LIMITS (SEC-04 Hardening)
    function isValidItemTextFields(data) {
      return (!('title' in data) || (data.title is string && data.title.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
             (!('color' in data) || data.color == null || (data.color is string && data.color.size() <= 50)) &&
             (!('brand' in data) || data.brand == null || (data.brand is string && data.brand.size() <= 60)) &&
             (!('contactInfo' in data) || data.contactInfo == null || (data.contactInfo is string && data.contactInfo.size() <= 150)) &&
             (!('contact' in data) || data.contact == null || (data.contact is string && data.contact.size() <= 150)) &&
             (!('aiPrompt' in data) || data.aiPrompt == null || (data.aiPrompt is string && data.aiPrompt.size() <= 500));
    }

    // ==========================================
    // 1. Users Collection
    // ==========================================
    match /users/{userId} {
      allow get: if isAuthUser(userId) || isAdmin();

      allow list: if isAdmin() ||
                     (isSignedIn() && isAccountActive() && resource.data.email == request.auth.token.email);

      // Create: usuário cria o próprio documento. O e-mail root pode criar
      // com qualquer papel (bootstrap do primeiro administrador).
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().id == userId &&
                       incoming().email == request.auth.token.email &&
                       (
                         isRootAdmin() || hasAdminClaim() ||
                         (
                           (
                             incoming().role == 'ALUNO' ||
                             (incoming().role == 'SERVIDOR' && isServidor()) ||
                             incoming().role == 'INTRUSO'
                           ) &&
                           (!('admin' in incoming()) || incoming().admin == false) &&
                           (incoming().approvalStatus == 'PENDENTE' || incoming().approvalStatus == 'APROVADO')
                         )
                       );

      // Update: admin altera qualquer perfil; usuário comum apenas o próprio
      // sem escalada de privilégio.
      allow update: if isAdmin() ||
                       (
                         isSignedIn() &&
                         isAccountActive() &&
                         request.auth.uid == userId &&
                         incoming().id == userId &&
                         incoming().email == existing().email &&
                         (
                           incoming().role == existing().role ||
                           (existing().role == 'INTRUSO' && incoming().role == 'ALUNO' && isInstitutionalStudentEmail()) ||
                           (existing().role == 'INTRUSO' && incoming().role == 'SERVIDOR' && isServidor())
                         ) &&
                         (!('admin' in incoming()) || incoming().admin == existing().admin) &&
                         (incoming().approvalStatus == existing().approvalStatus || (isEmailVerified() && incoming().approvalStatus == 'APROVADO')) &&
                         (!('status' in incoming()) || incoming().status == existing().status) &&
                         (!('suspendedUntil' in incoming()) || incoming().suspendedUntil == existing().suspendedUntil) &&
                         (!('reputationScore' in incoming()) || incoming().reputationScore == existing().reputationScore)
                       );

      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // ==========================================
    // 2. Lost & Found Items (LITE: leitura pública, escrita só ADMIN)
    // ==========================================
    match /items/{itemId} {
      allow get: if true;
      allow list: if true;

      // LITE: apenas administradores criam anúncios
      allow create: if isAdmin() &&
                    incoming().registeredByUserId == request.auth.uid &&
                    incoming().registeredByRole == 'ADMIN' &&
                    isValidItemTextFields(incoming());

      // LITE: apenas administradores editam
      allow update: if isAdmin() &&
                    incoming().registeredByUserId == existing().registeredByUserId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().registeredByRole == existing().registeredByRole &&
                    isValidItemTextFields(incoming());

      // LITE: apenas administradores excluem
      allow delete: if isAdmin();
    }

    match /found_items/{itemId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin() &&
                    incoming().registeredByUserId == request.auth.uid &&
                    incoming().registeredByRole == 'ADMIN' &&
                    isValidItemTextFields(incoming());
      allow update: if isAdmin() &&
                    incoming().registeredByUserId == existing().registeredByUserId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().registeredByRole == existing().registeredByRole &&
                    isValidItemTextFields(incoming());
      allow delete: if isAdmin();
    }

    match /lost_items/{itemId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin() &&
                    incoming().registeredByUserId == request.auth.uid &&
                    incoming().registeredByRole == 'ADMIN' &&
                    isValidItemTextFields(incoming());
      allow update: if isAdmin() &&
                    incoming().registeredByUserId == existing().registeredByUserId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().registeredByRole == existing().registeredByRole &&
                    isValidItemTextFields(incoming());
      allow delete: if isAdmin();
    }

    // ==========================================
    // 3. Item Claims (LITE: gestão de devolução exclusiva do ADMIN)
    // ==========================================
    match /claims/{claimId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 4. Notifications Collection
    // ==========================================
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        isAdmin() ||
        existing().userId == 'all' ||
        existing().userId == 'todos_alunos' ||
        existing().userId == 'todos' ||
        existing().isGlobal == true
      );

      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        resource.data.userId == 'all' ||
        resource.data.userId == 'todos_alunos' ||
        resource.data.userId == 'todos' ||
        resource.data.isGlobal == true
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        (isServidor() && isAccountActive()) ||
        (
          isAccountActive() &&
          incoming().userId == request.auth.uid &&
          (!('isGlobal' in incoming()) || incoming().isGlobal != true) &&
          incoming().userId != 'all' &&
          incoming().userId != 'todos' &&
          incoming().userId != 'todos_alunos' &&
          incoming().userId != 'todos_servidores' &&
          incoming().userId != 'global' &&
          (!('type' in incoming()) || incoming().type != 'SYSTEM') &&
          incoming().read == false
        )
      );

      allow update: if (
        isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().title == existing().title &&
        incoming().message == existing().message &&
        (!('type' in existing()) || incoming().type == existing().type) &&
        (!('isGlobal' in existing()) || incoming().isGlobal == existing().isGlobal) &&
        (!('timestamp' in existing()) || incoming().timestamp == existing().timestamp) &&
        (!('relatedItemId' in existing()) || incoming().relatedItemId == existing().relatedItemId) &&
        (!('id' in existing()) || incoming().id == existing().id)
      ) || isAdmin();

      allow delete: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ==========================================
    // 5. System Configuration Doc (Modo de Manutenção)
    // ==========================================
    match /system/{docId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 6. Audit Logs Collection (Trilha Imutável)
    // ==========================================
    match /activity_logs/{logId} {
      allow get: if isAdmin() || (isServidor() && isAccountActive());
      allow list: if isAdmin() || (isServidor() && isAccountActive());

      allow create: if isSignedIn() && (isAccountActive() || isAdmin()) &&
        (
          (!('actorId' in incoming()) || incoming().actorId == request.auth.uid) &&
          (!('adminId' in incoming()) || incoming().adminId == request.auth.uid) &&
          (!('actorEmail' in incoming()) || request.auth.token.email == null || incoming().actorEmail == request.auth.token.email) &&
          (!('adminEmail' in incoming()) || request.auth.token.email == null || incoming().adminEmail == request.auth.token.email) &&
          (
            (isAdmin() && (!('actorRole' in incoming()) || incoming().actorRole in ['ADMIN', 'SERVIDOR'])) ||
            (isServidor() && isAccountActive() && (!('actorRole' in incoming()) || incoming().actorRole == 'SERVIDOR')) ||
            (
              (incoming().actorRole == 'ALUNO' || incoming().userRole == 'ALUNO') &&
              incoming().action in ['CADASTRO_OCORRENCIA', 'EDIT_OCORRENCIA', 'STATUS_OVERRIDE', 'EXCLUSAO_ITEM']
            )
          )
        );

      allow update: if false;
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow get: if isAdmin() || (isServidor() && isAccountActive());
      allow list: if isAdmin() || (isServidor() && isAccountActive());

      allow create: if isSignedIn() && (isAccountActive() || isAdmin()) &&
        incoming().actorId == request.auth.uid &&
        (request.auth.token.email == null || incoming().actorEmail == request.auth.token.email) &&
        (
          (isAdmin() && incoming().actorRole in ['ADMIN', 'SERVIDOR']) ||
          (isServidor() && isAccountActive() && incoming().actorRole == 'SERVIDOR') ||
          (
            incoming().actorRole == 'ALUNO' &&
            incoming().objectType == 'ITEM' &&
            incoming().action in ['CADASTRO_OCORRENCIA', 'EDIT_OCORRENCIA', 'STATUS_OVERRIDE', 'EXCLUSAO_ITEM']
          )
        );

      allow update: if false;
      allow delete: if false;
    }

    // ==========================================
    // 7. Backup Logs Collection
    // ==========================================
    match /backup_logs/{logId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && incoming().adminId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ==========================================
    // 8. Error Logs Collection
    // ==========================================
    match /error_logs/{logId} {
      allow get: if isAdmin() || isServidor();
      allow list: if isAdmin() || isServidor();
      allow create: if isSignedIn() &&
                       (!('userId' in incoming()) || incoming().userId == request.auth.uid) &&
                       (!('userEmail' in incoming()) || request.auth.token.email == null || incoming().userEmail == request.auth.token.email);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ==========================================
    // 9. System Metrics Collection
    // ==========================================
    match /system_metrics/{metricId} {
      allow get: if isAdmin() || (isSignedIn() && metricId == 'heartbeat');
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (isSignedIn() && isAccountActive() && metricId == 'heartbeat');
      allow delete: if isAdmin();
    }

    // ==========================================
    // 10. Comments Collection (LITE: logados podem ler e comentar)
    // ==========================================
    match /comments/{commentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isAccountActive() &&
                       incoming().userId == request.auth.uid &&
                       (
                         (!('userRole' in incoming())) ||
                         (incoming().userRole == 'ALUNO') ||
                         (incoming().userRole == 'SERVIDOR' && isServidor()) ||
                         (incoming().userRole == 'ADMIN' && isAdmin())
                       );
      allow update: if isSignedIn() &&
                       isAccountActive() &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().itemId == existing().itemId &&
                       incoming().createdAt == existing().createdAt &&
                       (!('userRole' in incoming()) || incoming().userRole == existing().userRole);
      allow delete: if isAdmin() || (isSignedIn() && isAccountActive() && existing().userId == request.auth.uid);
    }

    // ==========================================
    // 11. FCM Subscriptions Collection
    // ==========================================
    match /fcm_subscriptions/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ==========================================
    // 12. Support & Feedback Tickets Collection
    // ==========================================
    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && isAccountActive() && resource.data.userId == request.auth.uid);
      allow create: if (
        (isSignedIn() &&
         incoming().userId == request.auth.uid &&
         (!('email' in incoming()) || incoming().email == request.auth.token.email) &&
         incoming().status == 'NOVO') ||
        (!isSignedIn() &&
         (!('userId' in incoming()) || incoming().userId == null || incoming().userId == '') &&
         (!('userRole' in incoming()) || incoming().userRole == null) &&
         incoming().status == 'NOVO')
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 13. Document Templates Collection (Admin Only)
    // ==========================================
    match /document_templates/{templateId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 14. Generated Documents Collection (Admin Only)
    // ==========================================
    match /generated_documents/{docId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 15. Project Settings Collection (Admin Only)
    // ==========================================
    match /project_settings/{settingsId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // 16. Test Battery Executions & Governance
    // ==========================================
    match /test_executions/{executionId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        isServidor() ||
        exists(/databases/$(database)/documents/test_participants/$(request.auth.uid))
      );
      allow create: if isAdmin() || isServidor();
      allow update: if (isAdmin() || isServidor() || (
        isSignedIn() &&
        isAccountActive() &&
        exists(/databases/$(database)/documents/test_participants/$(request.auth.uid))
      ));
      allow delete: if isAdmin();
    }

    // ==========================================
    // 17. Test Battery Participants Registry
    // ==========================================
    match /test_participants/{participantId} {
      allow get: if isSignedIn() && (request.auth.uid == participantId || isAdmin() || isServidor());
      allow list: if isAdmin() || isServidor();
      allow create, update: if isAdmin() || isServidor();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 18. Centralized Test Error Logs Collection
    // ==========================================
    match /test_error_logs/{logId} {
      allow get, list: if isAdmin() || isServidor();
      allow create: if isSignedIn() &&
                       isAccountActive() &&
                       incoming().batteryId is string && incoming().batteryId.size() > 0 && incoming().batteryId.size() <= 100 &&
                       incoming().testId is string && incoming().testId.size() > 0 && incoming().testId.size() <= 100 &&
                       incoming().action is string && incoming().action.size() > 0 && incoming().action.size() <= 50 &&
                       incoming().errorMessage is string && incoming().errorMessage.size() > 0 && incoming().errorMessage.size() <= 5000 &&
                       incoming().timestamp is string &&
                       (!('userId' in incoming()) || incoming().userId == request.auth.uid) &&
                       (!('userEmail' in incoming()) || request.auth.token.email == null || incoming().userEmail == request.auth.token.email);
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
